#3 A program that compiles all the way to native code.
   Integers and booleans only, which is what the LLVM backend
   covers in this v1 iteration.

func:int 'square' [var:int 'n'] {
    handback math { ('n') x ('n') }.
}.

print["Squares and a countdown."].

loop:var:int 'i' = math { 1 to 5 } {
    print["square: " 'square'[('i')]].
}.

var:int 'n' = '5'.
loop:while math { ('n') > 0 } {
    print["n = " ('n')].
    change:var:int 'n' = math { ('n') - 1 }.
}.

var:int 'total' = '0'.
loop:var:int 'k' = math { 1 to 100 } {
    change:var:int 'total' = math { ('total') + ('k') }.
}.
print["sum 1..100 = " ('total')].
